<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Gearzone.SiteMaster" %>

<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="GEARZONE - Cửa hàng phụ kiện laptop & PC chất lượng" />
    <title><%: Page.Title %> | GEARZONE</title>
    <link rel="stylesheet" href="<%: ResolveUrl("~/css/style.css") %>" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div id="toast" class="toast"></div>

        <!-- HEADER -->
        <header class="site-header">
            <div class="container header-inner">
                <a href="<%: ResolveUrl("~/Default.aspx") %>" class="logo">&#9889; GEARZONE</a>

                <div class="header-search">
                    <input type="search" id="txtSearchHeader" placeholder="&#128270; Tìm phụ kiện…" aria-label="Tìm kiếm" />
                    <button type="button" id="btnSearchHeader" onclick="doSearch()">Tìm</button>
                </div>

                <nav class="main-nav" aria-label="Điều hướng chính">
                    <a href="<%: ResolveUrl("~/Default.aspx") %>" id="navHome">&#127968; Trang chủ</a>
                    <a href="<%: ResolveUrl("~/Products.aspx") %>" id="navProducts">&#128230; Sản phẩm</a>
                    <a href="<%: ResolveUrl("~/Categories.aspx") %>" id="navCategories">&#128193; Danh mục</a>
                </nav>

                <div class="header-actions">
                    <a href="<%: ResolveUrl("~/Account.aspx") %>" id="lnkAccount">
                        &#128100; <asp:Label ID="lblAccountText" runat="server" Text="Tài khoản"></asp:Label>
                    </a>
                    <a href="<%: ResolveUrl("~/Cart.aspx") %>" id="lnkCart">
                        &#128722; <span>Giỏ hàng</span>
                        <span class="cart-count" id="cartCount">
                            <asp:Label ID="lblCartCount" runat="server" Text="0"></asp:Label>
                        </span>
                    </a>
                </div>
            </div>
        </header>

        <!-- MAIN CONTENT -->
        <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>

        <!-- FOOTER -->
        <footer class="site-footer">
            <div class="container">
                <div class="footer-inner">
                    <div class="footer-brand">
                        <span class="logo">&#9889; GEARZONE</span>
                        <p>Cửa hàng phụ kiện laptop & PC chất lượng. Cung cấp chuột, bàn phím, tai nghe, hub USB và nhiều phụ kiện công nghệ khác.</p>
                    </div>
                    <div class="footer-col">
                        <h4>Sản phẩm</h4>
                        <ul>
                            <li><a href="<%: ResolveUrl("~/Products.aspx") %>">Tất cả sản phẩm</a></li>
                            <li><a href="<%: ResolveUrl("~/Categories.aspx") %>">Danh mục</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Tài khoản</h4>
                        <ul>
                            <li><a href="<%: ResolveUrl("~/Login.aspx") %>">Đăng nhập</a></li>
                            <li><a href="<%: ResolveUrl("~/Register.aspx") %>">Đăng ký</a></li>
                            <li><a href="<%: ResolveUrl("~/Account.aspx") %>">Tài khoản</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Hỗ trợ</h4>
                        <ul>
                            <li><a href="#">Hướng dẫn mua hàng</a></li>
                            <li><a href="#">Chính sách đổi trả</a></li>
                            <li><a href="#">Liên hệ</a></li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>&copy; <%: DateTime.Now.Year %> GEARZONE - Đồ án môn Lập trình Web</p>
                </div>
            </div>
        </footer>
    </form>

    <script type="text/javascript">
        function doSearch() {
            var keyword = document.getElementById('txtSearchHeader').value.trim();
            if (keyword.length > 0) {
                window.location.href = 'Search.aspx?q=' + encodeURIComponent(keyword);
            }
        }
        document.getElementById('txtSearchHeader').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                doSearch();
            }
        });
        function showToast(message, duration) {
            var toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('show');
            setTimeout(function () {
                toast.classList.remove('show');
            }, duration || 2500);
        }
    </script>

    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
