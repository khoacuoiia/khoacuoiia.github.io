<!-- dataLayer bootstrap (server events + cookie consent state) -->
<script>
window.dataLayer = window.dataLayer || [];
(function(){
	function getCookie(name){
		var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
		return m ? decodeURIComponent(m.pop()) : '';
	}

	function readConsent(){
		var status = getCookie('cookieconsent_status');
		var raw = getCookie('cookieconsent_preferences_disabled');
		var disabled = raw ? raw.split(',').map(function(s){ return s.trim().toLowerCase(); }).filter(Boolean) : [];
		return {
			'cookieconsent_status': status || 'unknown',
			'cookieconsent_disabled': disabled,
			'cookieconsent_marketing': status === 'allow' && disabled.indexOf('marketing') === -1,
			'cookieconsent_analytics': status === 'allow' && disabled.indexOf('analytics') === -1,
			'cookieconsent_preferences': status === 'allow' && disabled.indexOf('preferences') === -1
		};
	}

	function consentKey(c){
		return c.cookieconsent_status + '|' + (c.cookieconsent_disabled || []).join(',');
	}

	// Seed the dataLayer with the current consent BEFORE GTM loads.
	var initialConsent = readConsent();
	window.dataLayer.push(initialConsent);
	window.__readCookieConsent = readConsent;
	window.__lastConsentKey = consentKey(initialConsent);

	// Replay server-rendered events (DataLayer::push() in PHP controllers).
	try {
		var serverEvents = [];
		if (serverEvents && serverEvents.length) {
			for (var i = 0; i < serverEvents.length; i++) {
				window.dataLayer.push(serverEvents[i]);
			}
		}
	} catch(e) {}

	// Push a consent_update event only when the cookie state actually changed.
	window.__pushConsentUpdate = function(reason){
		var c = readConsent();
		var key = consentKey(c);
		if (key === window.__lastConsentKey) return false;
		window.__lastConsentKey = key;
		var payload = { event: 'consent_update', consent_update_reason: reason || 'change' };
		for (var k in c) { if (c.hasOwnProperty(k)) payload[k] = c[k]; }
		window.dataLayer.push(payload);
		return true;
	};

	// Global helper for templates / inline scripts:
	//   window.dataLayerPush({ event: 'view_item', ecommerce: {...} });
	window.dataLayerPush = function(data){
		if (!data || typeof data !== 'object') return;
		var c = readConsent();
		var payload = {};
		for (var k in c) { if (c.hasOwnProperty(k)) payload[k] = c[k]; }
		for (var k2 in data) { if (data.hasOwnProperty(k2)) payload[k2] = data[k2]; }
		window.dataLayer.push(payload);
	};
})();
</script>

<!-- AddToCart Event -->
<script>
(function(){
	// Returns the most recent ecommerce item from a view_item event (product page).
	window.__dlGetLastViewedItem = function () {
		try {
			var dl = window.dataLayer || [];
			for (var i = dl.length - 1; i >= 0; i--) {
				var e = dl[i];
				if (e && e.event === 'view_item' && e.ecommerce && e.ecommerce.items && e.ecommerce.items[0]) {
					return e;
				}
			}
		} catch (e) {}
		return null;
	};

	window.__dlParseQuery = function (qs) {
		var out = {};
		if (!qs || typeof qs !== 'string') return out;
		qs.replace(/\+/g, ' ').split('&').forEach(function (pair) {
			if (!pair) return;
			var idx = pair.indexOf('=');
			var k = idx >= 0 ? pair.slice(0, idx) : pair;
			var v = idx >= 0 ? pair.slice(idx + 1) : '';
			try { k = decodeURIComponent(k); v = decodeURIComponent(v); } catch (e) {}
			out[k] = v;
		});
		return out;
	};

	// Global push helper for ATC (uses your consent-merging dataLayerPush)
	window.dataLayerAddToCart = function (quantity, override) {
		var last = window.__dlGetLastViewedItem();
		var item = last && last.ecommerce && last.ecommerce.items && last.ecommerce.items[0] ? last.ecommerce.items[0] : null;

		quantity = parseInt(quantity, 10);
		if (!quantity || quantity < 1) quantity = 1;

		var currency = (override && override.currency) || (last && last.ecommerce && last.ecommerce.currency) || (window.dataLayerCurrency || 'EUR');
		var price = item && typeof item.price === 'number' ? item.price : null;

		var atcItem = {};
		if (item) {
			// copy item fields (id/name/variant/categories/brand/price etc.)
			for (var k in item) { if (Object.prototype.hasOwnProperty.call(item, k)) atcItem[k] = item[k]; }
		}
		if (override && override.item_id) atcItem.item_id = override.item_id;
		if (override && override.item_name) atcItem.item_name = override.item_name;
		if (override && typeof override.price === 'number') { atcItem.price = override.price; price = override.price; }

		atcItem.quantity = quantity;

		var value = (typeof price === 'number') ? (price * quantity) : undefined;

		window.dataLayerPush({
			event: 'add_to_cart',
			ecommerce: {
				currency: currency,
				value: (typeof value === 'number' ? value : undefined),
				items: [atcItem]
			}
		});
	};

	// Auto-hook ALL $.ajax calls to checkout/cart/add
	if (window.jQuery && jQuery.ajax) {
		var _ajax = jQuery.ajax;
		jQuery.ajax = function (options) {
			var opts = options || {};
			var url = (opts.url || '').toString();
			var isAtc = url.indexOf('route=checkout/cart/add') !== -1;

			if (!isAtc) return _ajax.apply(this, arguments);

			// Try get qty/product_id from request payload
			var qs = null;
			if (typeof opts.data === 'string') qs = opts.data;
			else if (opts.data && typeof opts.data.serialize === 'function') qs = opts.data.serialize();

			var parsed = window.__dlParseQuery(qs);
			var qty = parsed.quantity || parsed['quantity'] || null;

			var origSuccess = opts.success;
			opts.success = function (json) {
				try {
					if (json && json.success) {
						// Some themes don't send quantity in payload; fall back to DOM
						var domQty = null;
						try { domQty = document.querySelector('#product input[name=\"quantity\"]'); } catch(e) {}
						var finalQty = qty || (domQty ? domQty.value : 1);

						window.dataLayerAddToCart(finalQty);
					}
				} catch (e) {}

				if (typeof origSuccess === 'function') {
					return origSuccess.apply(this, arguments);
				}
			};

			return _ajax.call(this, opts);
		};
	}
})();
</script>

<!-- Google Tag Manager (consent-gated) -->
<script>
(function(){
	var GTM_ID = 'GTM-TXQ69HB4';

	function marketingAllowed(){
		var c = window.__readCookieConsent ? window.__readCookieConsent() : null;
		return !!(c && c.cookieconsent_marketing);
	}

	var gtmLoaded = false;
	function loadGTM(){
		if (gtmLoaded) return;
		if (!marketingAllowed()) return;
		gtmLoaded = true;

		window.dataLayer.push({ 'event': 'cookieconsent_granted' });

		(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer',GTM_ID);

		var ns = document.createElement('noscript');
		var ifr = document.createElement('iframe');
		ifr.src = 'https://www.googletagmanager.com/ns.html?id=' + GTM_ID;
		ifr.height = '0';
		ifr.width = '0';
		ifr.style.display = 'none';
		ifr.style.visibility = 'hidden';
		ns.appendChild(ifr);
		if (document.body) {
			document.body.insertBefore(ns, document.body.firstChild);
		}
	}

	function checkConsent(reason){
		if (window.__pushConsentUpdate) window.__pushConsentUpdate(reason);
		if (marketingAllowed()) loadGTM();
	}

	if (marketingAllowed()) {
		loadGTM();
	} else {
		// Listen on the consent bar buttons instead of polling.
		// The cookie bar writes the cookies in its own click handlers, so we
		// re-check on the next tick.
		document.addEventListener('click', function(e){
			var t = e.target;
			if (!t || !t.closest) return;
			var match = t.closest('.cc-allow, .cc-btn-save-settings, .cc-dismiss, .cc-deny, .cc-revoke');
			if (!match) return;
			setTimeout(function(){ checkConsent('consent_button'); }, 50);
			setTimeout(function(){ checkConsent('consent_button_late'); }, 400);
		}, true);
	}

	// Handle revocation / other-tab changes.
	window.addEventListener('storage', function(){ checkConsent('storage'); });
	window.addEventListener('focus', function(){ checkConsent('focus'); });
})();
</script>
<!-- End Google Tag Manager -->


				<style>
			</style>
			<script>
				$(document).ready(function(){
					getButtonTexts();
				});
				
				function getButtonTexts() {
					$.ajax({
						url: 'index.php?route=extension/module/redirect_addtocart_buttons/getButtonTexts',
						dataType: 'json',
						error: function(xhr, status, error) {
							console.log(xhr.responseText ? xhr.responseText : error);
						},
						success: function(json) {
							$('*[onclick*="cart.add"], #button-cart, *[onclick*="addToCart"]').each(function(){
								element = $(this);
								
								if (element.attr('id') == 'button-cart') {
									var productID = $('input[name="product_id"]').val();
								} else {
									var first = element.attr('onclick').indexOf("'");
									var last = element.attr('onclick').indexOf("'", first + 1);
									var productID = element.attr('onclick').substring(first + 1, last);
								}
								
								if (json[productID]) {
									element.addClass('addtocart-redirect');
									if (element.find('span').length) element = element.find('span');
									element.html(json[productID]).val(json[productID]);
								}
							});
						},
					});
				}
			</script>
		
 			

